Vagrant.configure("2") do |config|
	ENV['VAGRANT_DEFAULT_PROVIDER'] = 'libvirt'

	config.vm.box = "generic/debian12"
	
	config.vm.define "junguyenS" do |control|
		control.vm.hostname = "junguyenS"
		control.vm.network "private_network", ip: "192.168.56.110"
		control.vm.synced_folder ".", "/vagrant", type: "rsync"
		control.vm.provider "libvirt" do |libvirt|
			libvirt.memory = 1024
			libvirt.cpus = 1
			libvirt.nested = true      # Virtualisation imbriquée
 			libvirt.driver = "kvm"     # Driver (kvm par défaut)
		end
		control.vm.provision "shell", path: "./scripts/scriptS.sh"
	end
end	