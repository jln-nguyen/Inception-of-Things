Vagrant.configure("2") do |config|
	ENV['VAGRANT_DEFAULT_PROVIDER'] = 'libvirt'
	config.vagrant.plugins = []  
	ENV['VAGRANT_NO_PARALLEL'] = 'yes'

	config.vm.box = "generic/debian11"
	
	config.vm.define "junguyenS" do |control|
		control.vm.hostname = "junguyenS"
		control.vm.network "private_network", ip: "192.168.56.110"
		control.vm.provider "libvirt" do |libvirt|
			# libvirt.customize ["modifyvm", :id, "--name", "junguyenS"]
			# libvirt.uri = "qemu:///system"
			libvirt.memory = 1024
			libvirt.cpus = 1
			libvirt.nested = true      # Virtualisation imbriquée
 			libvirt.driver = "kvm"     # Driver (kvm par défaut)
			# libvirt.gui = false #afficher fenetre vm ?
		end
		control.vm.provision "shell", path: "./scripts/scriptS.sh"
	end
	
	config.vm.define "junguyenSW" do |control|
		control.vm.hostname = "junguyenSW"
		control.vm.network "private_network", ip: "192.168.56.111"
		control.vm.provider "libvirt" do |libvirt|
			# libvirt.customize ["modifyvm", :id, "--name", "junguyenSW"]
			# libvirt.uri = "qemu:///system"
			libvirt.memory = 1024
			libvirt.cpus = 1
			libvirt.nested = true      # Virtualisation imbriquée
			libvirt.driver = "kvm"     # Driver (kvm par défaut)
			# libvirt.gui = false #afficher fenetre vm ?
		end
		control.vm.provision "shell", path: "./scripts/scriptSW.sh"
	end
end	